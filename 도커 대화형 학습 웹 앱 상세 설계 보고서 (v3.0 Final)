## 6. 정답 검증 엔진 (Evaluation Engine Specification)

### 6.1 부분 일치 기반 검증 원칙 (Subset Matching)
검증기는 사용자가 입력한 명령어 문자열이 아니라, 명령어 실행 후 생성된 `DockerEngineState`의 특정 속성 존재 여부만 검사합니다.

### 6.2 1-1 ~ 2-2 레벨 검증 알고리즘 명세 예시

```typescript
// 레벨 1-1 검증기: 첫 번째 웹 서버 컨테이너 실행
export function evaluateLevel1_1(state: DockerEngineState): EvaluationResult {
  const containers = Object.values(state.containers);
  if (containers.length === 0) {
    return { passed: false, message: '아직 실행된 컨테이너가 없습니다.', hint: '`docker run`을 실행해 보세요.' };
  }

  // 1. nginx 이미지 기반 컨테이너 검색
  const nginxContainer = containers.find(c => {
    const img = state.images[c.imageId];
    return img && img.repository === 'nginx';
  });
  if (!nginxContainer) {
    return { passed: false, message: 'nginx 이미지 기반 컨테이너가 없습니다.', hint: '`docker run ... nginx` 형태로 이미지를 지정하세요.' };
  }

  // 2. 실행 상태 검사
  if (nginxContainer.status !== 'running') {
    return { passed: false, message: '컨테이너가 실행 중이 아닙니다.', hint: '백그라운드 실행 옵션 `-d`를 확인하세요.' };
  }

  // 3. 포트 바인딩 검사 (부분 일치: 다른 포트가 추가되어도 8080:80이 있으면 통과)
  const hasPort = nginxContainer.ports.some(p => p.hostPort === 8080 && p.containerPort === 80);
  if (!hasPort) {
    return { passed: false, message: '호스트 8080 포트가 컨테이너 80 포트에 바인딩되지 않았습니다.', hint: '`-p 8080:80` 플래그를 점검하세요.' };
  }

  // 4. 컨테이너 이름 검사
  if (nginxContainer.name !== 'my-web') {
    return { passed: false, message: `컨테이너 이름이 '${nginxContainer.name}'입니다. 'my-web'으로 지정해야 합니다.`, hint: '`--name my-web` 옵션을 추가하세요.' };
  }

  return { passed: true, message: '🎉 축하합니다! 첫 번째 웹 서버 컨테이너를 올바르게 실행했습니다!' };
}

// 레벨 2-1 검증기: 볼륨 마운트 데이터 지속성
export function evaluateLevel2_1(state: DockerEngineState): EvaluationResult {
  const hasVolume = Boolean(state.volumes['my-db-data']);
  if (!hasVolume) {
    return { passed: false, message: 'my-db-data 볼륨이 생성되지 않았습니다.', hint: '`docker volume create my-db-data`를 먼저 실행하세요.' };
  }

  const containerWithVolume = Object.values(state.containers).find(c =>
    c.volumeMounts.some(v => v.volumeName === 'my-db-data' && v.containerPath === '/var/lib/mysql')
  );

  if (!containerWithVolume) {
    return { passed: false, message: 'my-db-data 볼륨이 /var/lib/mysql 경로에 마운트된 컨테이너가 없습니다.', hint: '`-v my-db-data:/var/lib/mysql` 옵션을 부여하세요.' };
  }

  return { passed: true, message: '🎉 영구 볼륨 연결에 성공했습니다! 컨테이너가 재시작되어도 데이터가 보존됩니다.' };
}
```

