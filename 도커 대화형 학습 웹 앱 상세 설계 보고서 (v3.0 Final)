## 3. 가상 도커 엔진 데이터 구조 (TypeScript State Schema)

도커 엔진 상태는 불변 객체(Immutable Object)로 관리되며, 모든 상태 변이는 딥 카피(Deep Copy)를 통해 수행됩니다.

```typescript
// 전체 엔진 루트 상태 인터페이스
export interface DockerEngineState {
  images: Record<string, ImageState>;          // 로컬 이미지 저장소 (Image ID 기준)
  containers: Record<string, ContainerState>;  // 컨테이너 풀 (Container ID 기준)
  volumes: Record<string, VolumeState>;        // 영구 볼륨 풀 (Volume Name 기준)
  networks: Record<string, NetworkState>;      // 가상 네트워크 풀 (Network Name 기준)
  buildContext: Record<string, string>;        // 가상 파일 시스템 (Dockerfile, compose.yaml)
}

// 1. 이미지 및 레이어 상태
export interface ImageState {
  id: string;                     // e.g., "img-nginx-latest"
  repository: string;             // e.g., "nginx"
  tag: string;                    // e.g., "latest"
  size: string;                   // e.g., "142MB"
  layers: string[];               // 레이어 명령어 스택
  createdAt: string;
}

// 2. 컨테이너 상태
export interface ContainerState {
  id: string;                     // e.g., "cnt-web-01"
  name: string;                   // e.g., "my-web"
  imageId: string;                // 참조하는 Image ID
  status: 'running' | 'stopped' | 'exited';
  ports: PortBinding[];           // 포트 바인딩 목록
  env: Record<string, string>;    // 환경 변수 맵
  volumeMounts: VolumeMount[];    // 볼륨 마운트 목록
  networkNames: string[];         // 소속된 네트워크 목록
  createdAt: string;
}

export interface PortBinding {
  hostPort: number;               // 호스트 노출 포트 (e.g., 8080)
  containerPort: number;          // 컨테이너 내부 포트 (e.g., 80)
  protocol: 'tcp' | 'udp';
}

export interface VolumeMount {
  volumeName: string;             // 대상 볼륨 이름
  containerPath: string;          // 컨테이너 마운트 경로
  mode: 'rw' | 'ro';
}

// 3. 볼륨 상태
export interface VolumeState {
  name: string;
  driver: 'local';
  data: Record<string, string>;   // 가상 영구 데이터 블록
  createdAt: string;
}

// 4. 네트워크 상태
export interface NetworkState {
  name: string;                   // e.g., "bridge", "app-net"
  driver: 'bridge' | 'host' | 'none';
  subnet: string;                 // e.g., "172.18.0.0/16"
  connectedContainerIds: string[];// 연결된 컨테이너 ID 배열
}

// 5. 스냅샷 타임머신 히스토리 인터페이스
export interface StateHistoryManager {
  past: DockerEngineState[];      // Undo용 이전 상태 스택 (최대 20개)
  present: DockerEngineState;     // 현재 활성 상태
  future: DockerEngineState[];    // Redo용 상태 스택
}
```

